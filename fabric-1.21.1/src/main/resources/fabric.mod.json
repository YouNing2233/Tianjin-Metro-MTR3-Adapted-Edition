{
    "schemaVersion": 1,
    "id": "tjmetro",
    "version": "${version}",
    "name": "Tianjin Metro - MTR3 Adapted Edition",
    "description": "Tianjin Metro content addon for Minecraft Transit Railway (NeoMTR). Supports Minecraft 1.21 / 1.21.1.",
    "authors": [
        "ZiYueCommentary (ziyue)",
        "jiangxingyunjian",
        "__Lingxii__ (lingxii)"
    ],
    "license": "GPL-3.0-only",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "ziyue.tjmetro.MainFabric"
        ],
        "client": [
            "ziyue.tjmetro.MainFabricClient"
        ]
    },
    "mixins": [
        "tjmetro.mixins.json",
        "tjmetro-fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.16.0",
        "fabric-api": "*",
        "architectury": "*",
        "minecraft": ">=1.21 <=1.21.1",
        "mtr": "*"
    },
    "suggests": {
        "cloth-config": "*"
    }
}
