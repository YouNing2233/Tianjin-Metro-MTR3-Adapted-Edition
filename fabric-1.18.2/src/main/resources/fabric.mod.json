    ],
    "contributors": [
    ],
    "contact": {
        "sources": "https://github.com/ZiYueCommentary/Tianjin-Metro",
        "issues": "https://github.com/ZiYueCommentary/Tianjin-Metro/issues",
        "email": "ziyuecommentary@gmail.com"
    },
    "license": "GPL-3.0-only",
